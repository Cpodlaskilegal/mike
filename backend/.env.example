PORT=3001
FRONTEND_URL=http://localhost:3000

# HMAC key used to sign /download/:token URLs. Required at startup.
# Generate with: openssl rand -hex 32
# Use a dedicated secret distinct from database/provider keys.
DOWNLOAD_SIGNING_SECRET=replace-with-a-random-32-byte-hex-string

DATABASE_URL=postgres://docket:<password>@<server>.postgres.database.azure.com:5432/docket?sslmode=require
PGSSLMODE=require

AZURE_TENANT_ID=your-azure-tenant-id
AZURE_API_CLIENT_ID=your-api-app-client-id
# Confidential credential for exchanging the signed-in user's Docket API token
# for a delegated Microsoft Graph Mail.Read token (OAuth OBO flow).
AZURE_API_CLIENT_SECRET=your-api-app-client-secret
# Must match the delegated scope exposed by the Docket API registration.
AZURE_API_SCOPE_NAME=access_as_user
AZURE_STORAGE_ACCOUNT=your-storage-account
AZURE_STORAGE_KEY=your-storage-account-key
AZURE_STORAGE_CONTAINER=documents
# Optional alternative to account/key:
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;...

GEMINI_API_KEY=your-gemini-key
ANTHROPIC_API_KEY=your-anthropic-key
OPENAI_API_KEY=your-openai-key
# Optional PostHog server-side instrumentation for AI observability.
# POSTHOG_KEY is the same project token that starts with phc_.
POSTHOG_KEY=phc_your_posthog_project_api_key
POSTHOG_HOST=https://us.i.posthog.com
# Keep legal prompts and model output redacted in PostHog by default.
POSTHOG_AI_CAPTURE_CONTENT=false
# Optional server-wide CourtListener token for US case-law research.
# Users can also save their own token in account settings.
COURTLISTENER_API_TOKEN=your-courtlistener-token
# Bulk cache/index mode is not wired for this Azure fork yet; leave disabled.
COURTLISTENER_BULK_DATA_ENABLED=false
RESEND_API_KEY=your-resend-key
# Required for the automatic $100 Docket account spend reports sent to admins.
# Use a verified Resend sender, for example: Docket <reports@your-domain.com>
SPEND_REPORT_FROM=Docket <reports@your-domain.com>
# Required for user-saved provider keys. Use a dedicated long random secret;
# do not reuse database, auth, or download-signing secrets.
USER_API_KEYS_ENCRYPTION_SECRET=your-long-random-secret
# Required for user MCP connector bearer tokens, OAuth tokens, and OAuth state.
# Use a dedicated long random secret; do not reuse other app secrets.
MCP_CONNECTORS_ENCRYPTION_SECRET=your-long-random-secret
# Public backend URL used as the OAuth callback origin for MCP connectors.
API_PUBLIC_URL=https://your-api.example.com
# Legacy shared-identity endpoint. Keep only until the per-user cutover.
PRACTICEPANTHER_MCP_SERVER_URL=https://wild-spark-qn7iy.run.mcp-use.com/mcp
# Set to the separate Manufact service's exact HTTPS /mcp URL to switch Docket
# to per-user PracticePanther OAuth. Each Docket user then connects their own
# PracticePanther account. Setting this retires old shared-identity connectors;
# an invalid or legacy URL fails closed rather than falling back.
# PRACTICEPANTHER_USER_MCP_SERVER_URL=https://your-new-server.example.com/mcp
# Set to false only for local diagnostics where PracticePanther should be hidden.
# PRACTICEPANTHER_MCP_ENABLED=false
# Box is connected by default as a backend-managed MCP connector. Create these
# OAuth credentials in Box Admin Console Integration Credentials and add this
# callback URL there:
# ${API_PUBLIC_URL}/user/mcp-connectors/oauth/callback
BOX_MCP_SERVER_URL=https://mcp.box.com
BOX_MCP_OAUTH_CLIENT_ID=your-box-mcp-oauth-client-id
BOX_MCP_OAUTH_CLIENT_SECRET=your-box-mcp-oauth-client-secret
# Defaults to "root_readwrite"; add ai.readwrite or docgen.readwrite only if
# your Box tenant/app has those scopes enabled.
# BOX_MCP_OAUTH_SCOPE=root_readwrite
# Set to false only for local diagnostics where Box should use the old preset.
# BOX_MCP_ENABLED=false

# --- Docket Agent gateway (/agent-mcp) ---------------------------------------
# Lets the Docket Agent email assistant use one Docket user's own
# PracticePanther, Box and Quo sign-ins. Server-to-server only.
# Turns the gateway on. A long random secret, 32+ characters
# (openssl rand -hex 32). Unset = every /agent-mcp request answers 503.
# Unsetting it is the kill switch.
# DOCKET_AGENT_OPS_TOKEN=
# The users Docket Agent may act for: firm addresses, comma separated.
# Empty or unset = nobody. No agent token can be made for anyone else, and a
# token stops working when its user is taken off this list.
# DOCKET_AGENT_ALLOWED_EMAILS=
# A second long random secret (openssl rand -hex 32), different from the
# ops token. It can read GET /agent-mcp/ops/status and nothing else. This is
# the one the Docket Agent Poller holds. The ops token above mints and
# revokes agent tokens: keep it with the operator, never in a vault.
# DOCKET_AGENT_STATUS_TOKEN=
# PracticePanther has no setting here. An agent token reaches the user's own
# per-user PracticePanther connection: the one Docket itself uses once
# PRACTICEPANTHER_USER_MCP_SERVER_URL above is set and he has connected it in
# Account > Connectors. While Docket is still on the shared connector in
# PRACTICEPANTHER_MCP_SERVER_URL, the gateway's PracticePanther source is off.
# Quo's MCP server URL. Unset = no Quo source. While set, an agent token may
# read the user's own Quo and create and update a contact or a task; never
# send a message or delete. Unsetting it is Quo's kill switch.
# DOCKET_AGENT_QUO_MCP_URL=
# on or off. Default off. While off, the gateway cannot change anything in
# PracticePanther. While on, an agent token may create and update tasks,
# time entries, notes, events, call logs, matters, logged emails, accounts,
# relationships and files; an admin's token also the money records Docket
# keeps admin-only (bank accounts, expense categories, expenses, flat fees,
# items). Never a delete, a PracticePanther message, or the raw API tool.
# DOCKET_AGENT_PRACTICEPANTHER_WRITES=off
# on or off. Default off. While off, Box through the MCP source is read-only.
# While on, an agent token may make a folder, move or copy a file or folder,
# change an item's name, description, tags and collections, and set metadata
# on it, in the token owner's own Box. Never a delete, a share, a
# collaboration change, a comment or a metadata template. A move or copy may
# name any folder, the account's root included: the user's own Box
# permissions decide, and in Box a move changes who can see the item.
# DOCKET_AGENT_BOX_ORGANIZE=off
# Only users with an email in this domain can be given an agent token.
# DOCKET_AGENT_EMAIL_DOMAIN=podlaskilegal.com
# Requests per window, per agent token, on the MCP routes.
# RATE_LIMIT_AGENT_MCP_MAX=1500
# RATE_LIMIT_AGENT_MCP_WINDOW_MINUTES=15
# Requests per window, per caller address, that carry no valid agent token.
# RATE_LIMIT_AGENT_MCP_UNAUTH_MAX=60
# Box files for Docket Agent (/agent-mcp/box/files). Reading the exact bytes
# of a file works as soon as the gateway is on. Filing is a separate switch:
# on or off, default off. While off, no file and no version can be uploaded.
# DOCKET_AGENT_BOX_UPLOADS=off
# The largest file a session may fetch, in MB. A larger one answers 413.
# DOCKET_AGENT_BOX_MAX_DOWNLOAD_MB=200
# The largest upload, in MB. Never more than 50 (Box's limit for an upload
# sent in one request), whatever is set here.
# DOCKET_AGENT_BOX_MAX_UPLOAD_MB=50
# Uploads per window (RATE_LIMIT_AGENT_MCP_WINDOW_MINUTES), per Box file
# token. Much smaller than the budget for reading, because an upload changes
# Box. More answers 429.
# DOCKET_AGENT_BOX_MAX_UPLOADS_PER_WINDOW=30
# New versions of one file per 24 hours, per user. Box keeps only a limited
# number of earlier versions; this keeps a run of uploads from pushing the
# real ones out. More answers 429.
# DOCKET_AGENT_BOX_MAX_VERSIONS_PER_DAY=10
